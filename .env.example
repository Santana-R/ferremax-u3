# Copiar a .env en la raiz del repositorio. Docker Compose lo lee al arrancar.
# Valores de ejemplo para desarrollo local; elegir una clave propia en .env.
POSTGRES_DB=ferremax
POSTGRES_USER=ferremax
POSTGRES_PASSWORD=reemplaza_esta_clave_local
POSTGRES_PORT=5433
# La API se ejecuta en tu equipo; dentro de Compose se usara el host db.
POSTGRES_HOST=127.0.0.1

# Copiar a .env en la raiz del repositorio. Docker Compose lo lee al arrancar.
# Valores de ejemplo para desarrollo local; elegir una clave propia en .env.
POSTGRES_DB=ferremax
POSTGRES_USER=ferremax
POSTGRES_PASSWORD=reemplaza_esta_clave_local
POSTGRES_PORT=5433
# Para ejecutar la API desde VS Code. Compose fija db:5432 dentro de los contenedores.
POSTGRES_HOST=127.0.0.1
# Puerto local de Swagger cuando App corre en Docker (opcional; por defecto 8000).
APP_PORT=8000
# Opcionales: false conserva el arranque local actual. Render los activa para su base nueva.
FERREMAX_INIT_DB=false
FERREMAX_SEED_DEMO=false

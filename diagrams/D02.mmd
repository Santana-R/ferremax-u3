classDiagram
    direction TB
    class Cotizacion {
      +id
      +folio
      +version
      +cliente_id
      +revalidar()
      +convertir()
    }
    class Pedido {
      +id
      +estado
      +cotizacion_version
      +confirmar()
      +cancelar()
      +cantidades_por_sku()
    }
    class InventarioUbicacion {
      +sku
      +ubicacion_id
      +existencia_fisica
      +disponible
      +reservar()
      +liberar()
    }
    class Partida {
      <<ValueObject>>
      +numero
      +sku
      +cantidad
      +precio
    }
    class Vigencia {
      +emision
      +vencimiento
      +esta_vigente()
    }
    class Dinero {
      +importe
      +moneda
    }
    class SKU {
      +valor
    }
    class CuentaCredito {
      +cliente_id
      +activo
      +bloqueado
      +evaluar()
    }
    class PoliticaCredito {
      +evaluar_normal()
    }
    Cotizacion "1" *-- "1..*" Partida : contiene
    Cotizacion "1" *-- "1" Vigencia : conserva
    Pedido "1" *-- "1..*" Partida : snapshot propio
    Pedido ..> Cotizacion : referencia ID y version
    InventarioUbicacion --> SKU : identifica producto
    Partida --> SKU : identifica producto
    Partida --> Dinero : precio
    CuentaCredito --> Dinero : limite y saldo
    PoliticaCredito ..> CuentaCredito : evalua
    InventarioUbicacion ..> Pedido : exige confirmado

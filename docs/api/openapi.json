{
  "openapi": "3.1.0",
  "info": {
    "title": "FerreMax - API",
    "description": "Inventario, cotizaciones y pedidos: consulta, confirmacion y cancelacion con reservas.",
    "version": "0.6.0"
  },
  "paths": {
    "/cotizaciones/{cotizacion_id}/versiones/{version}/revalidar": {
      "post": {
        "tags": [
          "Cotizaciones"
        ],
        "summary": "Renovar cotización vencida",
        "operationId": "revalidar_cotizacion_cotizaciones__cotizacion_id__versiones__version__revalidar_post",
        "parameters": [
          {
            "name": "cotizacion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "examples": [
                "11111111-1111-4111-8111-111111111111"
              ],
              "title": "Cotizacion Id"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "examples": [
                1
              ],
              "title": "Version"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevalidacionSolicitud"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CotizacionRevalidadaRespuesta"
                },
                "example": {
                  "mensaje": "Se renovó la cotización y se conservó la anterior en el historial.",
                  "cotizacion_id": "11111111-1111-4111-8111-111111111111",
                  "version_anterior": 1,
                  "folio": "COT-API-DEMO",
                  "version": 2,
                  "estado": "Vigente"
                }
              }
            }
          },
          "404": {
            "description": "Cotizacion o version no encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "mensaje": "No encontramos lo que buscas. Revisa los datos e inténtalo de nuevo."
                }
              }
            }
          },
          "409": {
            "description": "La version no admite esta revalidacion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "mensaje": "No se puede realizar esta operación en el estado actual. Revisa la cotización o el pedido."
                }
              }
            }
          },
          "422": {
            "description": "Revisar los datos de la revalidacion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "mensaje": "Revisa los datos proporcionados e inténtalo de nuevo."
                }
              }
            }
          },
          "503": {
            "description": "Revalidacion temporalmente no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "mensaje": "El servicio no está disponible por el momento. Inténtalo más tarde."
                }
              }
            }
          }
        }
      }
    },
    "/cotizaciones/{cotizacion_id}/versiones/{version}/convertir": {
      "post": {
        "tags": [
          "Cotizaciones"
        ],
        "summary": "Crear pedido",
        "operationId": "convertir_cotizacion_cotizaciones__cotizacion_id__versiones__version__convertir_post",
        "parameters": [
          {
            "name": "cotizacion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "examples": [
                "11111111-1111-4111-8111-111111111111"
              ],
              "title": "Cotizacion Id"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "examples": [
                2
              ],
              "title": "Version"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversionSolicitud"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PedidoCreadoRespuesta"
                },
                "example": {
                  "mensaje": "Pedido creado. Sigue pendiente de confirmación; todavía no se han reservado productos.",
                  "pedido_id": "22222222-2222-4222-8222-222222222222",
                  "estado": "Pendiente",
                  "cotizacion_id": "11111111-1111-4111-8111-111111111111",
                  "cotizacion_folio": "COT-API-DEMO",
                  "cotizacion_version": 2,
                  "total": "240.00",
                  "moneda": "MXN",
                  "disponibilidad_consultada": [
                    {
                      "sku": "FER-API-DEMO",
                      "solicitada": "2",
                      "disponible": "10"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Cotizacion o version no encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "mensaje": "No encontramos lo que buscas. Revisa los datos e inténtalo de nuevo."
                }
              }
            }
          },
          "409": {
            "description": "Cotizacion no vigente o sin aceptacion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "mensaje": "No se puede realizar esta operación en el estado actual. Revisa la cotización o el pedido."
                }
              }
            }
          },
          "422": {
            "description": "Revisar la solicitud o los productos de la cotizacion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "mensaje": "Revisa los datos proporcionados e inténtalo de nuevo."
                }
              }
            }
          },
          "503": {
            "description": "Creacion del pedido temporalmente no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "mensaje": "El servicio no está disponible por el momento. Inténtalo más tarde."
                }
              }
            }
          }
        }
      }
    },
    "/pedidos/{pedido_id}": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Consultar pedido",
        "operationId": "consultar_pedido_pedidos__pedido_id__get",
        "parameters": [
          {
            "name": "pedido_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",

        <mxCell id="A04_Note1" value="Rollback afecta la transacción; no constituye una transición comercial Confirmado → Pendiente ni revierte un pago externo." style="text;html=0;strokeColor=none;fillColor=none;align=left;fontSize=11;" parent="1" vertex="1">

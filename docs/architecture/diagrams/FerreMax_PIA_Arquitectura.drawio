        <mxCell id="A05_Note0" value="PK/FK corresponden al DDL real. Las multiplicidades describen filas posibles, no una implementación de todos los procesos U2." style="text;html=0;strokeColor=none;fillColor=none;align=left;fontSize=11;" parent="1" vertex="1">
